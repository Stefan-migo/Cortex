{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ".opencode/plugins/graphify.js"
  ],
  "mcp": {
    "graphify": {
      "type": "local",
      "enabled": true,
      "command": [
        "python3",
        "-m",
        "graphify.serve",
        "graphify-out/graph.json"
      ],
      "_description": "Graphify \u2014 knowledge graph queries via MCP"
    }
  }
}